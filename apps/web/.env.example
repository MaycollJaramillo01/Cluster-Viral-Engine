# Example values ONLY. All credentials are server-side and specific to environment.
APP_ENV=development
DATABASE_URL=postgresql://runtime:<PASSWORD>@<host>-pooler.neon.tech/<db>?sslmode=verify-full
AUTH_DATABASE_URL=postgresql://identity:<PASSWORD>@<host>-pooler.neon.tech/<db>?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://migrator:<PASSWORD>@<host>.neon.tech/<db>?sslmode=verify-full
BETTER_AUTH_URL=https://<exact-environment-host>
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SECRET=REPLACE_ME_64_RANDOM_BYTES
APP_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_BYTES
# Solo con APP_ENV=local: EDITORIAL_MODEL=mock activa un modelo sintético. Fuera de local, BLOCKED_EXTERNAL.
EDITORIAL_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Solo con APP_ENV=local: TTS_PROVIDER=mock activa un tono sintético marcado. elevenlabs exige clave y tarifa de tu plan; sin ellas, BLOCKED_EXTERNAL.
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_USD_PER_1K_CHARS=
BLOB_READ_WRITE_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
WORKER_SHARED_SECRET=
MAX_COST_USD_PER_VIDEO=3.00
# El tope mensual vigente es organizations.monthly_budget_usd; esta variable todavía no se lee.
MONTHLY_HARD_CAP_USD=100.00
RENDER_BACKEND=external-worker

# Phase 00 trusted local CLI only; do not use a migration/owner connection here.
PHASE00_DATABASE_URL=
PHASE00_ACTOR_ID=
# Disposable empty integration-test DB only. Test refuses an existing organizations table.
PHASE00_TEST_ADMIN_URL=
PHASE01_TEST_ADMIN_URL=
