{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research dossier",
  "type": "object",
  "required": [
    "story_title",
    "sources",
    "claims",
    "needs_human_review"
  ],
  "additionalProperties": false,
  "properties": {
    "story_title": {
      "type": "string"
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "retrieved_at",
          "publisher"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "source_ids",
          "high_risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "DISPUTED",
              "ALLEGATION",
              "UNVERIFIED",
              "OPINION",
              "RECONSTRUCTION"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "high_risk": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
