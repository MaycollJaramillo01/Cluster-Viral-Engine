{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "organization_id",
    "project_id",
    "width",
    "height",
    "fps",
    "locale",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "width": {
      "const": 1080
    },
    "height": {
      "const": 1920
    },
    "fps": {
      "const": 30
    },
    "locale": {
      "const": "es-419"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_ms",
          "narration",
          "audio_object_key",
          "visual_asset_id",
          "license_approved",
          "motion",
          "transition",
          "on_screen_text",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 500,
            "maximum": 240000
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "audio_object_key": {
            "type": "string",
            "minLength": 1
          },
          "visual_asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "license_approved": {
            "type": "boolean"
          },
          "motion": {
            "enum": [
              "static",
              "zoom_in",
              "zoom_out",
              "pan_left",
              "pan_right",
              "map_motion"
            ]
          },
          "transition": {
            "enum": [
              "cut",
              "fade",
              "dissolve"
            ]
          },
          "on_screen_text": {
            "type": "string",
            "maxLength": 240
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "is_ai_reconstruction": {
            "type": "boolean",
            "default": false
          },
          "subtitle_segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_ms",
                "end_ms",
                "text"
              ],
              "properties": {
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
