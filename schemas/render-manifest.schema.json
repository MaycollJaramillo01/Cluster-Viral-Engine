{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "organization_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "script_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1080
        },
        "height": {
          "type": "number",
          "const": 1920
        },
        "fps": {
          "type": "number",
          "const": 30
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "total_ms": {
      "type": "integer",
      "minimum": 120000,
      "maximum": 240000
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "audio_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pause_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "motion": {
            "type": "string",
            "enum": [
              "zoom_in",
              "pan_left",
              "zoom_out",
              "pan_right"
            ]
          },
          "transition": {
            "type": "string",
            "enum": [
              "cut",
              "fade"
            ]
          },
          "overlay": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "visual": {
            "type": "object",
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^org\\/[0-9a-f-]{36}\\/project\\/[0-9a-f-]{36}\\/[a-z]+\\/[0-9a-f]{64}\\.(png|jpg|mp4|mp3|wav)$"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "asset_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "IMAGE",
                  "VIDEO"
                ]
              },
              "is_ai_generated": {
                "type": "boolean"
              }
            },
            "required": [
              "object_key",
              "content_sha256",
              "asset_id",
              "kind",
              "is_ai_generated"
            ],
            "additionalProperties": false
          },
          "voice": {
            "type": "object",
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^org\\/[0-9a-f-]{36}\\/project\\/[0-9a-f-]{36}\\/[a-z]+\\/[0-9a-f]{64}\\.(png|jpg|mp4|mp3|wav)$"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generation_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "timing_source": {
                "type": "string",
                "enum": [
                  "PROVIDER",
                  "SYNTHETIC"
                ]
              }
            },
            "required": [
              "object_key",
              "content_sha256",
              "generation_id",
              "timing_source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "start_ms",
          "audio_ms",
          "pause_ms",
          "claim_ids",
          "motion",
          "transition",
          "overlay",
          "visual",
          "voice"
        ],
        "additionalProperties": false
      }
    },
    "music": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "object_key": {
              "type": "string",
              "pattern": "^org\\/[0-9a-f-]{36}\\/project\\/[0-9a-f-]{36}\\/[a-z]+\\/[0-9a-f]{64}\\.(png|jpg|mp4|mp3|wav)$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "asset_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "duration_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "object_key",
            "content_sha256",
            "asset_id",
            "duration_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "captions": {
      "type": "object",
      "properties": {
        "srt": {
          "type": "string",
          "minLength": 1
        },
        "ass": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "srt",
        "ass"
      ],
      "additionalProperties": false
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "organization_id",
    "project_id",
    "script_version",
    "script_sha256",
    "format",
    "title",
    "total_ms",
    "scenes",
    "music",
    "captions",
    "credits"
  ],
  "additionalProperties": false
}
